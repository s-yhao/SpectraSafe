{
  "experiment_name": "spectrasafe_vphmdb",
  "output_dir": "../outputs/vphmdb",
  "dataset": "vphmdb",
  "video_root": "${VPHMDB_ROOT}",
  "split_root": "${VPHMDB_SPLITS}",
  "privacy_label_pkl": "${VPHMDB_PRIVACY_LABELS}",
  "action_classes_file": "${VPHMDB_CLASS_INDEX}",
  "split_index": 1,
  "num_classes": 51,
  "num_privacy_attributes": 5,
  "num_frames": 16,
  "image_size": 224,
  "videomaev2_root": "${VIDEOMAEV2_ROOT}",
  "videomaev2_checkpoint": "${VIDEOMAEV2_CHECKPOINT}",
  "anonymizer_blocks": 1,
  "mask_skin_weight": 1.0,
  "mask_motion_weight": 1.0,
  "mask_power": 0.6,
  "policy_bf16": true,
  "fft_point_hidden_dim": 64,
  "adversarial_epochs": 30,
  "benchmark_epochs": 70,
  "adversarial_batch_size": 8,
  "adversarial_val_batch_size": 32,
  "benchmark_batch_size": 16,
  "benchmark_val_batch_size": 16,
  "lr_fa": 0.00007,
  "lr_ft": 0.00003,
  "lr_fb": 0.00005,
  "seed": 42
}
